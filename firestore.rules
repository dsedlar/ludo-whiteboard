rules_version = '2';
// Who can read and change the shared playbook.
// Staff: the ves.org accounts listed in the document config/staff (an array field named "emails").
// Everyone else with a verified ves.org account can only read plays marked "Show this play to players".
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@ves[.]org$');
    }
    function staff() {
      return signedIn()
        && request.auth.token.email in get(/databases/$(db)/documents/config/staff).data.emails;
    }
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;   // edit the staff list in the Firebase console only
    }
    match /plays/{id} {
      allow read: if staff() || (signedIn() && resource.data.team == true);
      allow write: if staff();
    }
    match /overlays/{id} {
      allow read: if signedIn();
      allow write: if staff();
    }
    match /library/{id} {
      allow read, write: if staff();
    }
  }
}
